# Copy to .env.local and fill in values.
# Never commit .env.local (it is gitignored).

# ── Supabase (required) ──
# Dashboard: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Cloudinary (required for photo uploads in the editor) ──
# Dashboard: https://console.cloudinary.com → Product environment credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Settings → Upload → Upload presets → Add upload preset (unsigned)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# ── Site URL (required in production for WhatsApp / OG previews) ──
# Your public app URL, no trailing slash — used for absolute Open Graph image URLs.
# On Vercel, VERCEL_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
