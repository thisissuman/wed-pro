# Setup template only: values/provider settings are unconfirmed.
# Task 16 is in progress; provider setup/writes require a designated disposable target.
# See docs/environment-and-ci.md and docs/cloudinary-uploads.md.
# Copy to .env.local and fill in values during authorized setup.
# Never commit .env.local (it is gitignored).

# ── Supabase (required) ──
# Dashboard: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Cloudinary (required for authenticated photo/audio uploads in the editor) ──
# Dashboard: https://console.cloudinary.com → Product environment credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Server-only credentials; never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Separate SIGNED presets; see docs/cloudinary-uploads.md.
CLOUDINARY_IMAGE_UPLOAD_PRESET=your_signed_image_preset
CLOUDINARY_AUDIO_UPLOAD_PRESET=your_signed_audio_preset
# Confirm and set your actual product environment mode: fixed or dynamic.
# The example value below is not proof that the provider uses dynamic mode.
CLOUDINARY_FOLDER_MODE=dynamic

# ── Site URL (required in production for WhatsApp / OG previews) ──
# Your public app URL, no trailing slash — used for absolute Open Graph image URLs.
# Explicit configuration is required for matching browser/server production links.
# VERCEL_URL is a server-only fallback; it does not configure the browser.
# Production example: https://wed-pro.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Reserved browser authentication inputs ──
# Existing specs do not yet consume these inputs for authenticated lifecycle coverage.
# Use dedicated disposable owners; never delete personal invitations for test capacity.
# CI forwards these values, but setting them alone does not create auth coverage.
# PLAYWRIGHT_TEST_EMAIL=test@example.com
# PLAYWRIGHT_TEST_PASSWORD=your-test-password
# Optional existing disposable app server; otherwise Playwright manages build/start.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# ── Dedicated disposable database suite (never falls back to app/production env) ──
# Two distinct EMPTY fixture-owner accounts/profiles; no service-role key needed.
# Set in a private environment, not in checked-in CI defaults. See verification docs.
# WED_TEST_SUPABASE_URL=http://127.0.0.1:54321
# WED_TEST_DISPOSABLE_TARGET=http://127.0.0.1:54321
# WED_TEST_SUPABASE_ANON_KEY=your-test-anon-key
# WED_TEST_OWNER_A_EMAIL=owner-a@example.test
# WED_TEST_OWNER_A_PASSWORD=private-fixture-password
# WED_TEST_OWNER_B_EMAIL=owner-b@example.test
# WED_TEST_OWNER_B_PASSWORD=private-fixture-password
